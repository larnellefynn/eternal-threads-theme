{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "none"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "et_extras": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'et-product-extras', product: product %}"
          }
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "block_heading": "Complete the look",
            "make_collapsible_row": false,
            "product_list_limit": 2,
            "products_per_page": 2,
            "pagination_style": "dots",
            "icon": "none",
            "image_ratio": "portrait",
            "enable_quick_add": true
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "buy_buttons",
        "et_extras",
        "complementary"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "columns",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": true,
        "padding_top": 0,
        "padding_bottom": 48
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 3,
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 64,
        "padding_bottom": 96
      }
    }
  },
  "order": [
    "main",
    "related-products"
  ]
}