{%- liquid
  assign h = section.settings.height
  assign tone = section.settings.text_tone
  assign place = section.settings.text_position
-%}
<section class="et-banner et-banner--{{ tone }}" style="height: {{ h }}px; background: #b9bcbf;" aria-labelledby="EtBanner-{{ section.id }}">
  <div class="et-banner__media">
    {%- render 'et-image',
      image: section.settings.image,
      fallback: section.settings.fallback,
      alt: section.settings.image_alt,
      position: section.settings.focal,
      eager: true
    -%}
  </div>
  <div class="et-banner__copy et-banner__copy--{{ place }}">
    {%- if section.settings.show_crumbs -%}
      <nav class="et-banner__crumbs" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">Home</a>
        {%- if template.name == 'collection' and collection.handle != 'all' %} / <a href="{{ routes.all_products_collection_url }}">Shop all</a>{% endif %}
        / <span aria-current="page">{{ section.settings.heading | default: collection.title | default: page_title }}</span>
      </nav>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="et-label">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 id="EtBanner-{{ section.id }}" class="et-banner__title">{{ section.settings.heading | default: collection.title | default: page_title }}</h1>
    {%- if section.settings.text != blank -%}
      <p class="et-banner__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label_1 != blank or section.settings.button_label_2 != blank -%}
      <div class="et-banner__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a class="button" href="{{ section.settings.button_link_1 | default: routes.all_products_collection_url }}">{{ section.settings.button_label_1 }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a class="button button--secondary" href="{{ section.settings.button_link_2 | default: routes.root_url }}">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "ET banner",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Built-in photo (used when no image is picked)", "info": "Filename of a campaign photo bundled with the theme. Leave as is, or pick an image above." },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "focal", "label": "Focal point", "default": "center center", "info": "CSS position, e.g. 'center 30%' or '60% 25%'." },
    { "type": "range", "id": "height", "label": "Height", "min": 360, "max": 900, "step": 20, "unit": "px", "default": 560 },
    { "type": "select", "id": "text_tone", "label": "Text colour on desktop", "default": "dark", "options": [ { "value": "dark", "label": "Black" }, { "value": "light", "label": "Cream" } ] },
    { "type": "select", "id": "text_position", "label": "Text position", "default": "bottom", "options": [ { "value": "bottom", "label": "Bottom left" }, { "value": "top", "label": "Top left" } ] },
    { "type": "checkbox", "id": "show_crumbs", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Small label above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank on collection pages to use the collection name." },
    { "type": "text", "id": "text", "label": "Line under heading" },
    { "type": "text", "id": "button_label_1", "label": "Button 1 label" },
    { "type": "url", "id": "button_link_1", "label": "Button 1 link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 label (outline)" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 link" }
  ],
  "presets": [ { "name": "ET banner" } ]
}
{% endschema %}
